        "type": "prometheus",
        "uid": "UeV7jcYVk"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
