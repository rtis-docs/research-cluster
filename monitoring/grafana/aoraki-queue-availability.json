      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "UeV7jcYVk"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, partition) (rate(aoraki_job_wait_seconds_bucket{partition=~\"aoraki_gpu.*\"}[24h])))",
          "legendFormat": "{{partition}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
