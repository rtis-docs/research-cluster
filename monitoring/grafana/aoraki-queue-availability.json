      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "UeV7jcYVk"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le, partition) (rate(aoraki_job_wait_seconds_bucket[6h])))",
          "legendFormat": "{{partition}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 102,
      "type": "bargauge",
      "title": "Typical wait on each GPU partition, last 24 hours",
      "description": "The headline number: how long a job submitted to each GPU partition has recently taken to start. Picking a quieter GPU type is usually the single biggest thing a user can do to start sooner.",
      "datasource": {
        "type": "prometheus",
        "uid": "UeV7jcYVk"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "orange",
                "value": 21600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
