{
  "uid": "aoraki-queue",
  "title": "Aoraki - Queue and Availability",
  "description": "Queue wait times and free-versus-used resources for the Aoraki cluster. Panel IDs are embedded by the documentation site and must stay stable.",
  "tags": [
    "aoraki",
    "slurm"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "How long jobs are waiting",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 100,
      "type": "timeseries",
      "title": "Median wait before starting, by partition",
      "description": "Time from a job becoming eligible to run until it started. Measured from Eligible, not Submit, so a --begin or dependency hold is not counted against the cluster. Waits under 5 seconds cannot be resolved further.",
      "datasource": {
        "type": "prometheus",
        "uid": "UeV7jcYVk"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "UeV7jcYVk"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, partition) (rate(aoraki_job_wait_seconds_bucket[6h])))",
          "legendFormat": "{{partition}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Slow end of the queue (p90), by partition",
      "description": "Nine jobs in ten started sooner than this. Watch the gap against the median: a partition with a low median and a high p90 is usually fine but occasionally very slow.",
